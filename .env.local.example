/**
 * API 凭据。复制为 .env.local 后填入。
 * TMDB: https://www.themoviedb.org/settings/api
 * Fanart.tv: https://fanart.tv/get-an-api-key/ （个人 key 免费）
 * Supabase: 项目 Settings → API
 */

# ---- TMDB（电影基础数据 / 海报）----
# v3 Key 用于 REST 数据；v4 Bearer Token 更安全，二者留其一即可
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ---- Fanart.tv（超清无字海报 / 背景图）----
FANART_API_KEY=
NEXT_PUBLIC_FANART_IMAGE_BASE=https://assets.fanart.tv

# ---- Supabase（收藏 / 自定义词条 / 海报资产）----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
